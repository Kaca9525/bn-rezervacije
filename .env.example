# Trajni disk za bazu (OBAVEZNO u produkciji, inace se pri svakom deploy-u brisu nalozi i rezervacije)
DATA_DIR=/data

# Sopstveni domen - postaviti tek kad domen otvara aplikaciju; stara onrender.com adresa tada preusmerava na njega
# SITE_URL=https://beautyandnutrition.app

# SMS podsetnici klijentima (24h pre termina i na dan termina) - izaberite JEDNOG provajdera.
# Infobip (dobar izbor za Srbiju): API ključ i Base URL se vide u Infobip nalogu
# INFOBIP_API_KEY=xxxxxxxxxxxxxxxx
# INFOBIP_BASE_URL=https://xxxxxx.api.infobip.com
# ili Twilio:
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxx
# Ime pošiljaoca (do 11 slova i brojeva, bez razmaka); za Srbiju ga provajder registruje/odobrava
# SMS_FROM=BNSalon
# Od kog sata ide SMS „na dan termina" (podrazumevano 8 = 8h); posle 21h se SMS ne šalje
# SMS_DAY_HOUR=8
# Probni režim: poruke se samo ispisuju u log servera, ništa se ne šalje
# SMS_PROVIDER=log
